      {
        "id": 4,
        "type": "stat",
        "title": "Average lead/cycle time (days, done items)",
        "description": "Uses Created and Status Category Changed (both clean date fields) to compute days in flight. Caveat: this seed dataset was created moments ago, so every issue's Created/Status-Category-Changed are only seconds apart -- the mechanism is real, but the number will read ~0 until this runs against issues with real history.",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 16,
          "y": 0
        },
        "datasource": {
          "type": "grafana-jira-datasource",
          "uid": "afzngd12kho1sc"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "grafana-jira-datasource",
              "uid": "afzngd12kho1sc"
            },
            "domain": "issues",
            "queryType": "",
            "jql": "project = DAT AND issuetype in (Story, Bug) AND status = Done",
            "maxDataPoints": 200,
            "fields": [
              {
                "custom": "",
                "id": "key",
                "items": "",
                "label": "Key",
                "system": "",
                "text": "Key",
                "type": "string",
                "value": "key"
              },
              {
                "custom": "",
                "id": "created",
                "items": "",
                "label": "Created",
                "system": "created",
                "text": "Created",
                "type": "date",
                "value": "created"
              },
              {
                "custom": "",
                "id": "statuscategorychangedate",
                "items": "",
                "label": "Status Category Changed",
                "system": "statuscategorychangedate",
                "text": "Status Category Changed",
                "type": "date",
                "value": "statuscategorychangedate"
              }
            ]
          }
        ],
        "fieldConfig": {
          "defaults": {},
          "overrides": []
        },
        "options": {},
        "transformations": [
          {
            "id": "calculateField",
            "options": {
              "mode": "reduceRow",
              "reduce": {
                "reducer": "diff",
                "include": [
                  "created",
                  "statuscategorychangedate"
                ]
              },
              "alias": "Difference"
            }
          },
          {
            "id": "calculateField",
            "options": {
              "mode": "binary",
              "alias": "Days",
              "binary": {
                "left": "Difference",
                "operator": "/",
                "right": "86400000"
              }
            }
          },
          {
            "id": "filterFieldsByName",
            "options": {
              "include": {
                "names": [
                  "Days"
                ]
              }
            }
          },
          {
            "id": "reduce",
            "options": {
              "reducers": [
                "mean"
              ]
            }
          }
        ]
      },
